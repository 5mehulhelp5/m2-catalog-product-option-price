<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="quote_item">
        <column xsi:type="decimal" name="options_price" scale="4" precision="20" unsigned="false" nullable="true" default="0" comment="Options price"/>
        <column xsi:type="decimal" name="base_options_price" scale="4" precision="20" unsigned="false" nullable="true" default="0" comment="Base options price"/>
